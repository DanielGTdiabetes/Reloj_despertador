[Unit]
Description=Reloj Despertador
After=multi-user.target
Wants=multi-user.target

[Service]
Type=notify
User=dani
WorkingDirectory=/home/dani/reloj_despertador
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/bin/bash /home/dani/reloj_despertador/scripts/preflight_hw.sh
ExecStart=/usr/bin/python3 -u src/main.py
Restart=always
RestartSec=5
StartLimitIntervalSec=0
WatchdogSec=90
NotifyAccess=main
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reloj

[Install]
WantedBy=multi-user.target
